{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "prototype",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "--yes",
        "http-server",
        "prototype",
        "-p",
        "5173",
        "-c-1"
      ],
      "port": 5173
    },
    {
      "name": "web",
      "runtimeExecutable": "npx",
